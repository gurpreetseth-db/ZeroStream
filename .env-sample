# =============================================================================
# ZeroStream Environment Configuration
# 
# This file contains BASE configuration for infrastructure setup.
# After running `infra/setup_infra.sh`, all configuration (including
# generated values like warehouse IDs, credentials, etc.) is saved to
# `generated_config.env` which becomes the single source of truth.
#
# NEVER commit .env or generated_config.env to version control
# =============================================================================

# ── Infrastructure Setup (used by infra/setup_infra.sh) ──────────────────────
# Prefix for all resource names
INFRA_PREFIX=

# ── Databricks ────────────────────────────────────────────────────────────────
DATABRICKS_HOST=<YOUR_DATABRICKS_HOST>
DATABRICKS_TOKEN=<YOUR_DATABRICKS_TOKEN>

# ── Delta Table (Unity Catalog) ───────────────────────────────────────────────
CATALOG=<YOUR_CATALOG>
SCHEMA=<YOUR_SCHEMA>
TABLE_NAME=sensor_zerobus_stream

# Optional managed storage locations (leave empty for default)
CATALOG_STORAGE_LOCATION="s3://<YOUR_STORAGE_FOLDER>/"
SCHEMA_STORAGE_LOCATION="s3://<YOUR_STORAGE_FOLDER>/${SCHEMA}/"

# ── ZeroBus ───────────────────────────────────────────────────────────────────
# Zerobus configurations

ZEROBUS_SERVER_ENDPOINT=<WORKSPACE_ID>.zerobus.<WORKSPACE_REGION>.cloud.databricks.com
ZEROBUS_TOPIC=${INFRA_PREFIX}_sensor_stream_topic
ZEROBUS_SP_NAME=${INFRA_PREFIX}-zerobus-service

# ── Lakebase (PostgreSQL) ─────────────────────────────────────────────────────
# Lakebase configurations

LAKEBASE_INSTANCE=${INFRA_PREFIX}-lakebase
LAKEBASE_CATALOG=${INFRA_PREFIX}_lakebase
LAKEBASE_DATABASES=lakebaseprovisioned
LAKEBASE_SCHEMA=lakebaseprovisioned
LAKEBASE_PORT=5432
LAKEBASE_MIN_CAPACITY=8.0
LAKEBASE_MAX_CAPACITY=16.0
LAKEBASE_SCALE_TO_ZERO=10

# ── SQL warehouse ───────────────────────────────────────────────────────
# SQL Warehouse configurations

WAREHOUSE_NAME=${INFRA_PREFIX}_warehouse
WAREHOUSE_TYPE="PRO"
WAREHOUSE_CLUSTER_SIZE="Small"
WAREHOUSE_MAX_NUM_CLUSTERS=1
WAREHOUSE_ENABLE_SERVERLESS_COMPUTE=true

# ── Databricks Apps settings ───────────────────────────────────────────────────────
# Databricks Apps configurations

MOBILE_APP_NAME=${INFRA_PREFIX}-mobile-app
DASHBOARD_APP_NAME=${INFRA_PREFIX}-dashboard-app
APP_COMPUTE_SIZE="MEDIUM"

# ── Streaming behaviour ───────────────────────────────────────────────────────
# How often each simulated device sends a reading (milliseconds)
STREAM_INTERVAL_MS=5000
# Seconds of inactivity before a client is marked as inactive on dashboard
ACTIVE_WINDOW_SECONDS=5



LAKEBASE_USERNAME=<YOUR_LAKEBASE_USERNAME>
DATABRICKS_ACCOUNT_ID=<YOUR_DATABRICKS_ACCOUNT_ID>
